#!/usr/bin/env python3
"""Dashbots reporter. One record shape, every harness.

Hooks must exit 0 and stay quiet on stdout. The Gemini adapter prints {}
itself. The Antigravity adapter prints {} too. On PreToolUse it prints ask,
which prompts and does not authorize the tool. On Stop it prints a decision
that lets the turn end. Debug goes to stderr only when DASHBOTS_DEBUG is set.
"""

import json
import os
import random
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
import traceback
from datetime import datetime, timezone

ADDR_RE = re.compile(r"^0x[0-9a-fA-F]+$")
ID_RE = re.compile(r"[A-Za-z0-9._-]+")
HARNESS_RE = re.compile(r"[a-z0-9_-]{1,32}")
STATUSES = ("alive", "working", "waiting", "error")
DEFAULT_ICONS = "botvaders"
ICON_SET_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}")
CONFIG_ASSIGN_RE = re.compile(r"^(\s*)([A-Za-z][A-Za-z0-9]*)(\s+)(\S+)(.*)$")
ADAPTERS = ("grok", "claude", "gemini", "agy")
SCAN_NAMES = ("grok", "claude", "gemini", "agy", "codex", "opencode")

SNAKE_EVENTS = {
    "session_start": "SessionStart",
    "session_end": "SessionEnd",
    "user_prompt_submit": "UserPromptSubmit",
    "pre_tool_use": "PreToolUse",
    "post_tool_use": "PostToolUse",
    "post_tool_use_failure": "PostToolUseFailure",
    "stop": "Stop",
    "stop_failure": "StopFailure",
    "stop_cancelled": "StopCancelled",
    "notification": "Notification",
    "before_agent": "BeforeAgent",
    "after_agent": "AfterAgent",
    "before_tool": "BeforeTool",
    "after_tool": "AfterTool",
    "before_model": "BeforeModel",
    "after_model": "AfterModel",
}

GROK_EVENTS = (
    "SessionStart",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "PostToolUseFailure",
    "Stop",
    "StopFailure",
    "StopCancelled",
    "Notification",
    "SessionEnd",
)
# Claude ignores StopCancelled and warns on every launch if it is listed.
# Grok still emits that event, so the Grok hook file keeps it.
CLAUDE_EVENTS = tuple(event for event in GROK_EVENTS if event != "StopCancelled")
GEMINI_EVENTS = (
    "SessionStart",
    "BeforeAgent",
    "BeforeTool",
    "BeforeModel",
    "AfterTool",
    "AfterModel",
    "AfterAgent",
    "Notification",
    "SessionEnd",
)
NEW_TURN_EVENTS = {"UserPromptSubmit", "BeforeAgent"}
STOP_EVENTS = {"Stop", "StopCancelled", "AfterAgent"}
AGY_EVENTS = (
    "PreInvocation",
    "PreToolUse",
    "PostToolUse",
    "PostInvocation",
    "Stop",
)
AGY_ASK_TOOLS = {"ask_question", "ask_permission"}
AGY_HOOK_KEY = "dashbots"
PLUGIN_ID = "io.github.dayruke.dashbots"
LEGACY_PLUGIN_ID = "dashbots"


def debug(msg):
    if os.environ.get("DASHBOTS_DEBUG"):
        print(msg, file=sys.stderr)


def repo_root():
    here = os.path.realpath(os.path.abspath(__file__))
    return os.path.dirname(os.path.dirname(here))


def home():
    return os.path.expanduser("~")


def state_root():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local", "state")
    return os.path.join(base, "dashbots")


def sessions_dir():
    return os.path.join(state_root(), "sessions")


def adapters_dir():
    return os.path.join(state_root(), "adapters")


def toggle_path():
    override = os.environ.get("DASHBOTS_TOGGLE_FILE")
    if override:
        return override
    return os.path.join(home(), ".local", "state", "omarchy", "toggles", "dashbots")


def toggle_on():
    return os.path.isfile(toggle_path())


def bin_path():
    return os.path.join(home(), ".local", "bin", "dashbots")


def lib_dir():
    return os.path.join(home(), ".local", "lib", "dashbots")


def plugin_dir():
    return os.path.join(home(), ".config", "omarchy", "plugins", PLUGIN_ID)


def legacy_plugin_dir():
    return os.path.join(home(), ".config", "omarchy", "plugins", LEGACY_PLUGIN_ID)


def same_dir(left, right):
    return os.path.realpath(left) == os.path.realpath(right)


def shell_json_path():
    override = os.environ.get("DASHBOTS_SHELL_FILE")
    if override:
        return override
    return os.path.join(home(), ".config", "omarchy", "shell.json")


def config_path():
    override = os.environ.get("DASHBOTS_CONFIG")
    if override:
        return override
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")
    return os.path.join(base, "dashbots", "config")


# center-left is just left of the clock and weather.
# center-right is just right of the weather. That is the default.
# left is just right of the workspace listing.
# right is just right of the tray. The bar keeps the tray at the inner
# edge of that side, so the marks sit beside the chevron.
# Each value is section, anchors in preference order, and which side of the anchor.
PLACES = {
    "center-left": ("center", ("omarchy.clock", "omarchy.weather"), "before"),
    "center-right": ("center", ("omarchy.weather", "omarchy.clock"), "after"),
    "left": ("left", ("omarchy.workspaces",), "after"),
    "right": ("right", ("omarchy.tray",), "after"),
}


def default_config_text():
    path = os.path.join(repo_root(), "config")
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def config_assignments(text):
    """Key and value tokens from a config. Comments and blank lines are skipped."""
    for raw in str(text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        yield parts[0], parts[1]


def apply_config_assignment(settings, key, value):
    """Store one accepted assignment. A rejected value leaves settings unchanged."""
    if key == "swingMs":
        try:
            number = int(value)
        except ValueError:
            return
        if number > 0:
            settings["swingMs"] = number
    elif key == "animate":
        word = value.lower()
        if word in ("true", "yes", "1", "on"):
            settings["animate"] = True
        elif word in ("false", "no", "0", "off"):
            settings["animate"] = False
    elif key == "place" and value in PLACES:
        settings["place"] = value
    elif key == "icons":
        token = value.lower()
        if ICON_SET_RE.fullmatch(token):
            settings["icons"] = token


def parse_config(text):
    settings = {
        "swingMs": 2000,
        "animate": True,
        "place": "center-right",
        "icons": DEFAULT_ICONS,
    }
    for key, value in config_assignments(text):
        apply_config_assignment(settings, key, value)
    return settings


def config_overrides(text):
    """Values this file sets. A missing or rejected key is left out."""
    found = {}
    for key, value in config_assignments(text):
        apply_config_assignment(found, key, value)
    return found


def format_config_value(key, value):
    if key == "animate":
        return "true" if value else "false"
    return str(value)


def render_config(overrides):
    """Shipped config with saved values written onto the matching lines."""
    pieces = []
    for raw in default_config_text().splitlines(keepends=True):
        ending = ""
        body = raw
        if body.endswith("\n"):
            body = body[:-1]
            ending = "\n"
        match = CONFIG_ASSIGN_RE.match(body)
        if match and match.group(2) in overrides:
            key = match.group(2)
            body = (
                f"{match.group(1)}{key}{match.group(3)}"
                f"{format_config_value(key, overrides[key])}{match.group(5)}"
            )
        pieces.append(body + ending)
    return "".join(pieces)


def read_config():
    path = config_path()
    try:
        with open(path, encoding="utf-8") as handle:
            parsed = parse_config(handle.read())
    except OSError:
        parsed = parse_config("")
    parsed["icons"] = active_icons(parsed)
    return parsed


def shipped_icons_root():
    return os.path.join(repo_root(), "plugin", "icons")


def resolve_icons_root(override, installed, shipped):
    """The folder the bar draws. An override wins, then the installed plugin."""
    if override:
        return override
    if installed and os.path.isdir(installed):
        return installed
    return shipped


def icons_root():
    return resolve_icons_root(
        os.environ.get("DASHBOTS_ICONS"),
        os.path.join(plugin_dir(), "plugin", "icons"),
        shipped_icons_root(),
    )


def icon_sets():
    root = icons_root()
    found = []
    try:
        names = os.listdir(root)
    except OSError:
        return []
    for name in names:
        if not ICON_SET_RE.fullmatch(name):
            continue
        if os.path.isdir(os.path.join(root, name)):
            found.append(name)
    found.sort()
    return found


def active_icons(settings=None):
    """The set the bar draws. A missing name falls back to botvaders."""
    if settings is None:
        settings = read_config()
    requested = str(settings.get("icons") or DEFAULT_ICONS)
    available = icon_sets()
    if requested in available:
        return requested
    if DEFAULT_ICONS in available:
        return DEFAULT_ICONS
    return available[0] if available else DEFAULT_ICONS


def bodies(set_name=None, root=None):
    """Icon ids in one set. Awake file is {id}.svg. Asleep is {id}-asleep.svg."""
    name = active_icons() if set_name is None else set_name
    folder = os.path.join(root or icons_root(), name)
    found = []
    try:
        names = os.listdir(folder)
    except OSError:
        return ()
    for filename in names:
        if not filename.endswith(".svg") or filename.endswith("-asleep.svg"):
            continue
        stem = filename[: -len(".svg")]
        if ICON_SET_RE.fullmatch(stem):
            found.append(stem)
    found.sort()
    return tuple(found)


def write_config_file(path, text):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent or ".", prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def install_config():
    """Write the shipped config. An existing file is refreshed.

    Comments and settings added since that file was written come from the
    current template. A value the file already sets is kept when this version
    still accepts it. A rejected value is dropped. The file is left untouched
    when the refresh would not change it, and when it cannot be read.
    """
    path = config_path()
    existing = None
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as handle:
                existing = handle.read()
        except (OSError, UnicodeError) as exc:
            print(f"skipped config update: {exc}", file=sys.stderr)
            return
    updated = render_config(config_overrides(existing or ""))
    if existing == updated:
        return
    write_config_file(path, updated)
    if existing is not None:
        print(f"config: refreshed {path}")


MENU_ID = "trigger.toggle.dashbots"
MENU_ENTRY = {
    "icon": "■■",
    "label": "Dashbots",
    "checked": "omarchy-toggle-enabled dashbots",
    "action": "omarchy-toggle dashbots",
}


def systemd_user_dir():
    return os.path.join(home(), ".config", "systemd", "user")


def now_stamp():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ensure_private_dir(path):
    os.makedirs(path, exist_ok=True)
    os.chmod(path, 0o700)


def sanitize_id(value):
    text = str(value or "")
    if not text or text in (".", "..") or "/" in text or "\\" in text:
        return ""
    if not ID_RE.fullmatch(text):
        return ""
    return text


def sanitize_harness(value):
    text = str(value or "").strip().lower()
    if HARNESS_RE.fullmatch(text):
        return text
    return ""


def session_path(session_id):
    return os.path.join(sessions_dir(), session_id + ".json")


def read_record(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    return data


def sanitize_body(value, catalog=None):
    text = str(value or "").strip().lower()
    if not ICON_SET_RE.fullmatch(text):
        return ""
    if catalog is None:
        catalog = bodies()
    if text in catalog:
        return text
    return ""


def choose_body(except_id=None):
    """Pick an icon that no other live session is using, if one is free."""
    catalog = bodies()
    if not catalog:
        return ""
    counts = {body: 0 for body in catalog}
    skip = sanitize_id(except_id or "")
    for record in iter_records():
        if sanitize_id(record.get("id")) == skip:
            continue
        if not pid_alive(record.get("pid")):
            continue
        body = sanitize_body(record.get("body"), catalog)
        if body:
            counts[body] += 1
    least = min(counts.values())
    pool = [body for body in catalog if counts[body] == least]
    return random.choice(pool)


def ensure_body(record):
    catalog = bodies()
    body = sanitize_body(record.get("body"), catalog)
    if body:
        record["body"] = body
        return body
    session_id = sanitize_id(record.get("id"))
    previous = read_record(session_path(session_id)) if session_id else None
    kept = sanitize_body(previous.get("body"), catalog) if previous else ""
    record["body"] = kept or choose_body(session_id)
    return record["body"]


def keep_created_at(previous, record, stamp):
    """First appearance. A later status write must not move the mark."""
    if isinstance(previous, dict):
        kept = str(previous.get("created_at") or "")
        if kept:
            return kept
        # Records written before this field existed keep their old place.
        kept = str(previous.get("updated_at") or "")
        if kept:
            return kept
    incoming = str(record.get("created_at") or "")
    return incoming or stamp


def write_record(record):
    session_id = sanitize_id(record.get("id"))
    if not session_id:
        return
    record = dict(record)
    record["id"] = session_id
    ensure_body(record)
    destination = session_path(session_id)
    previous = read_record(destination)
    stamp = now_stamp()
    record["created_at"] = keep_created_at(previous, record, stamp)
    record["updated_at"] = stamp
    ensure_private_dir(sessions_dir())
    fd, tmp = tempfile.mkstemp(dir=sessions_dir(), prefix=".tmp-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(record, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, destination)
        os.chmod(destination, 0o600)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def delete_record(session_id):
    session_id = sanitize_id(session_id)
    if not session_id:
        return
    try:
        os.remove(session_path(session_id))
    except FileNotFoundError:
        pass


def iter_records():
    directory = sessions_dir()
    if not os.path.isdir(directory):
        return
    for name in sorted(os.listdir(directory)):
        if not name.endswith(".json") or name.startswith("."):
            continue
        record = read_record(os.path.join(directory, name))
        if record:
            yield record


def field(payload, *keys, default=""):
    for key in keys:
        if key in payload and payload[key] is not None:
            return payload[key]
    return default


def event_name(payload):
    raw = str(field(payload, "hook_event_name", "hookEventName", default="") or "")
    return SNAKE_EVENTS.get(raw, raw)


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            raw = handle.read()
    except OSError:
        return []
    parts = []
    for piece in raw.split(b"\0"):
        if piece:
            parts.append(piece.decode("utf-8", "replace"))
    return parts


def comm_of(pid):
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8", errors="replace") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def ppid_of(pid):
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except (OSError, IndexError, ValueError):
        return 0
    return 0


def pid_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                if line.startswith("State:"):
                    state = line.split()[1] if len(line.split()) > 1 else ""
                    return state != "Z"
    except OSError:
        return False
    return False


def is_helper(args):
    for arg in args:
        base = os.path.basename(arg)
        if base == "dashbots" or arg.endswith("/bin/dashbots"):
            return True
        if "/lib/dashbots/" in arg or "/dashbots/adapters/" in arg:
            return True
    return False


def classify_args(args, comm):
    """Return a scan harness name, or None. Helpers are not harnesses."""
    args = list(args or [])
    comm = str(comm or "")
    if not args and not comm:
        return None
    if args and is_helper(args):
        return None
    base = os.path.basename(args[0]) if args else comm
    if base in ("node", "nodejs") or comm in ("node", "nodejs"):
        for arg in args[1:]:
            name = os.path.basename(arg)
            if name in ("gemini", "gemini.js"):
                return "gemini"
        return None
    if base in SCAN_NAMES:
        return base
    if comm in SCAN_NAMES:
        return comm
    return None


def harness_of(pid):
    # comm is one short read. Only a harness name or node (Gemini) needs cmdline.
    comm = comm_of(pid)
    if comm not in SCAN_NAMES and comm not in ("node", "nodejs"):
        return None
    return classify_args(cmdline(pid), comm)


def find_ancestor(harness, start_pid):
    pid = start_pid
    seen = set()
    while pid and pid > 1 and pid not in seen and len(seen) < 40:
        seen.add(pid)
        if harness_of(pid) == harness:
            return pid
        pid = ppid_of(pid)
    return None


def hook_pid(harness):
    if os.environ.get("DASHBOTS_HOOK_ASSUME") == "1":
        raw = os.environ.get("DASHBOTS_HOOK_PID") or str(os.getpid())
        try:
            return int(raw)
        except ValueError:
            return None
    return find_ancestor(harness, os.getppid())


def iter_pids():
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if name.isdigit():
            yield int(name)


def ensure_hypr_env():
    """Point hyprctl at the running compositor.

    A user service can start before Hyprland's instance signature is in
    the systemd user environment. hyprctl then sees no clients, and a
    mark never learns its window. One instance directory under the
    runtime hypr folder is that signature.
    """
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    runtime = os.environ.get("XDG_RUNTIME_DIR") or os.path.join("/run/user", str(os.getuid()))
    hypr_dir = os.path.join(runtime, "hypr")
    try:
        names = [
            name for name in os.listdir(hypr_dir)
            if name and not name.startswith(".")
            and os.path.isdir(os.path.join(hypr_dir, name))
        ]
    except OSError:
        return
    if len(names) != 1:
        return
    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = names[0]


def hypr_clients():
    ensure_hypr_env()
    try:
        result = subprocess.run(
            ["hyprctl", "clients", "-j"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if result.returncode != 0:
        return []
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def window_for(pid, clients=None):
    if clients is None:
        clients = hypr_clients()
    by_pid = {}
    for client in clients:
        if not isinstance(client, dict):
            continue
        try:
            client_pid = int(client.get("pid") or 0)
        except (TypeError, ValueError):
            continue
        address = str(client.get("address") or "")
        if client_pid > 0 and ADDR_RE.fullmatch(address):
            by_pid[client_pid] = address
    seen = set()
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return ""
    while pid and pid > 1 and pid not in seen and len(seen) < 40:
        seen.add(pid)
        if pid in by_pid:
            return by_pid[pid]
        pid = ppid_of(pid)
    return ""


def cwd_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def title_of(cwd, harness):
    text = str(cwd or "").rstrip("/")
    base = os.path.basename(text) if text else ""
    return (base or harness or "agent")[:80]


def first_line(value):
    text = str(value or "").strip()
    if not text:
        return ""
    return text.splitlines()[0][:160]


def prompt_text(payload):
    raw = field(payload, "prompt", "userPrompt", "user_prompt", "message", default="")
    if isinstance(raw, dict):
        raw = raw.get("text") or raw.get("content") or ""
    return first_line(raw)


def tool_name(payload):
    return first_line(field(payload, "toolName", "tool_name", default=""))


def prompt_id(payload):
    return str(field(payload, "promptId", "prompt_id", default="") or "")


def session_id_of(payload):
    for key in ("sessionId", "session_id"):
        found = sanitize_id(payload.get(key))
        if found:
            return found
    return sanitize_id(os.environ.get("GEMINI_SESSION_ID", ""))


def is_subagent(payload):
    return bool(field(payload, "subagentType", "subagent_type", default=""))


def payload_has_error(payload):
    if payload.get("error") or payload.get("is_error") or payload.get("isError"):
        return True
    for key in ("tool_response", "toolResponse", "toolResult", "tool_result"):
        value = payload.get(key)
        if isinstance(value, dict) and value.get("error"):
            return True
        if isinstance(value, dict):
            for exit_key in ("exitCode", "exit_code"):
                if exit_key in value and value[exit_key] not in (0, "0", None):
                    return True
    for exit_key in ("exitCode", "exit_code"):
        if exit_key in payload and payload[exit_key] not in (0, "0", None):
            return True
    return False


def notification_type(payload):
    return str(field(payload, "notificationType", "notification_type", default="") or "")


def blank_record(session_id, harness, pid, cwd):
    return {
        "id": session_id,
        "harness": harness,
        "pid": int(pid),
        "cwd": cwd or "",
        "title": title_of(cwd, harness),
        "status": "alive",
        "window": "",
        "updated_at": now_stamp(),
        "activity": "",
        "source": "hook",
        "turn": "",
    }


def load_or_blank(session_id, harness, pid, cwd):
    current = read_record(session_path(session_id))
    if not current:
        return blank_record(session_id, harness, pid, cwd)
    current["harness"] = harness
    current["pid"] = int(pid)
    if cwd:
        current["cwd"] = cwd
        if not current.get("title"):
            current["title"] = title_of(cwd, harness)
    current["source"] = "hook"
    current.setdefault("activity", "")
    current.setdefault("turn", "")
    current.setdefault("window", "")
    current.setdefault("status", "alive")
    return current


def stale_turn(record, event_turn):
    """A late event for an older prompt must not clobber the new turn."""
    if not event_turn:
        return False
    stored = str(record.get("turn") or "")
    if not stored:
        return False
    return event_turn != stored


def delete_scan_twin(pid):
    directory = sessions_dir()
    if not os.path.isdir(directory):
        return
    suffix = f"-{int(pid)}.json"
    for name in os.listdir(directory):
        if name.startswith("scan-") and name.endswith(suffix):
            try:
                os.remove(os.path.join(directory, name))
            except OSError:
                pass


def other_hook_sessions(harness, pid, session_id):
    """Hook marks for this process other than session_id."""
    harness = sanitize_harness(harness)
    keep = sanitize_id(session_id)
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return []
    found = []
    for record in iter_records():
        if record.get("source") != "hook":
            continue
        if sanitize_harness(record.get("harness")) != harness:
            continue
        try:
            if int(record.get("pid")) != pid:
                continue
        except (TypeError, ValueError):
            continue
        other = sanitize_id(record.get("id"))
        if other and other != keep:
            found.append(record)
    return found


def claim_session(harness, pid, session_id, name):
    """One hook mark per process.

    A new conversation in the same process replaces the previous mark.
    A late event from the conversation that was replaced must not paint
    a second icon on that window.
    """
    siblings = other_hook_sessions(harness, pid, session_id)
    current = read_record(session_path(session_id))
    owning = name == "SessionStart" or name in NEW_TURN_EVENTS
    if current is None and siblings and not owning:
        return False
    if current is not None and siblings and not owning:
        newest = max(str(item.get("updated_at") or "") for item in siblings)
        if newest > str(current.get("updated_at") or ""):
            delete_record(session_id)
            return False
    for record in siblings:
        delete_record(record.get("id"))
    return True


def stale_same_pid_ids(records):
    """Older hook marks that share a live process with a newer conversation."""
    groups = {}
    for record in records:
        if record.get("source") != "hook":
            continue
        harness = sanitize_harness(record.get("harness"))
        session_id = sanitize_id(record.get("id"))
        try:
            pid = int(record.get("pid"))
        except (TypeError, ValueError):
            continue
        if not harness or not session_id:
            continue
        groups.setdefault((harness, pid), []).append(record)
    stale = []
    for grouped in groups.values():
        if len(grouped) < 2:
            continue
        grouped.sort(key=lambda item: (str(item.get("updated_at") or ""), str(item.get("id") or "")))
        for record in grouped[:-1]:
            stale.append(sanitize_id(record.get("id")))
    return stale


def agy_cwd(payload):
    paths = payload.get("workspacePaths")
    if isinstance(paths, list):
        for item in paths:
            if item:
                return str(item)
    return str(field(payload, "cwd", "workspaceRoot", "workspace_root", default="") or "")


def agy_tool_name(payload):
    call = payload.get("toolCall")
    if isinstance(call, dict) and call.get("name"):
        return first_line(call.get("name"))
    return tool_name(payload)


def agy_stop_error(payload):
    if payload.get("error"):
        return True
    return str(payload.get("terminationReason") or "") == "error"


def agy_fully_idle(payload):
    if "fullyIdle" not in payload:
        return True
    return bool(payload.get("fullyIdle"))


def apply_agy(payload, pid):
    """One mark per agy process. Stop leaves the record until the process exits."""
    name = event_name(payload)
    if name not in AGY_EVENTS:
        return 0
    session_id = sanitize_id(f"agy-{int(pid)}")
    if not session_id:
        return 0
    cwd = agy_cwd(payload)
    record = load_or_blank(session_id, "agy", pid, cwd)
    window = window_for(pid)
    if window:
        record["window"] = window
    elif "window" not in record:
        record["window"] = ""
    tool = agy_tool_name(payload)
    if name == "PreInvocation":
        record["status"] = "working"
        record["activity"] = "thinking"
    elif name == "PreToolUse":
        if tool in AGY_ASK_TOOLS:
            record["status"] = "waiting"
            record["activity"] = "needs a decision"
        else:
            record["status"] = "working"
            record["activity"] = tool or "working"
    elif name == "PostToolUse":
        record["status"] = "working"
        if tool:
            record["activity"] = tool
    elif name == "PostInvocation":
        record["status"] = "working"
    elif name == "Stop":
        if agy_stop_error(payload):
            record["status"] = "error"
            record["activity"] = "error"
        else:
            record["status"] = "waiting"
            record["activity"] = "idle" if agy_fully_idle(payload) else "background still running"
    else:
        return 0
    delete_scan_twin(pid)
    write_record(record)
    return 0


def apply_hook(payload, harness):
    """Apply one hook payload. Always meant to be followed by exit 0."""
    if not isinstance(payload, dict):
        return 0
    harness = sanitize_harness(harness)
    if harness not in ADAPTERS:
        return 0
    if not toggle_on():
        return 0
    if is_subagent(payload):
        return 0
    pid = hook_pid(harness)
    if not pid:
        return 0
    if harness == "agy":
        return apply_agy(payload, pid)
    session_id = session_id_of(payload)
    name = event_name(payload)
    if name == "SessionEnd":
        if session_id:
            delete_record(session_id)
        return 0
    if not session_id or not name:
        return 0

    cwd = str(field(payload, "cwd", "workspaceRoot", "workspace_root", default="") or "")
    record = load_or_blank(session_id, harness, pid, cwd)
    turn = prompt_id(payload)
    # Stop carries the turn guard. A notification describes the session now,
    # including an idle ping that has no prompt id.
    if name not in NEW_TURN_EVENTS | {"Notification", "SessionStart"} and stale_turn(record, turn):
        return 0

    window = window_for(pid)
    if window:
        record["window"] = window
    elif "window" not in record:
        record["window"] = ""

    if name == "SessionStart":
        record["status"] = "alive"
        record["activity"] = "started"
        record["title"] = title_of(record.get("cwd"), harness)
        record["turn"] = ""
    elif name in NEW_TURN_EVENTS:
        record["status"] = "working"
        record["turn"] = turn
        activity = prompt_text(payload)
        record["activity"] = activity or "working"
    elif name in ("PreToolUse", "BeforeTool", "BeforeModel"):
        record["status"] = "working"
        if turn:
            record["turn"] = turn
        named = tool_name(payload)
        record["activity"] = named or ("thinking" if name == "BeforeModel" else record.get("activity") or "working")
    elif name == "AfterModel":
        record["status"] = "working"
        if turn:
            record["turn"] = turn
    elif name in ("PostToolUse", "AfterTool"):
        if turn:
            record["turn"] = turn
        if payload_has_error(payload):
            record["status"] = "error"
            named = tool_name(payload)
            record["activity"] = named or "error"
        else:
            record["status"] = "working"
            named = tool_name(payload)
            if named:
                record["activity"] = named
    elif name == "PostToolUseFailure":
        record["status"] = "error"
        if turn:
            record["turn"] = turn
        named = tool_name(payload)
        record["activity"] = named or "error"
    elif name in STOP_EVENTS:
        record["status"] = "waiting"
        record["activity"] = record.get("activity") or "waiting"
    elif name == "StopFailure":
        record["status"] = "error"
        record["activity"] = "error"
    elif name == "Notification":
        kind = notification_type(payload)
        if kind == "idle_prompt":
            record["status"] = "waiting"
            record["activity"] = "idle"
        elif kind in ("permission_prompt", "elicitation_dialog", "ToolPermission"):
            record["status"] = "waiting"
            record["activity"] = "needs a decision"
        else:
            return 0
    else:
        return 0

    if record.get("status") not in STATUSES:
        return 0
    if not claim_session(harness, pid, session_id, name):
        return 0
    delete_scan_twin(pid)
    write_record(record)
    return 0


def slot_stamp(record):
    """Order key. created_at stays put across status changes."""
    return str(record.get("created_at") or record.get("updated_at") or "")


def live_records():
    found = []
    for record in iter_records():
        if pid_alive(record.get("pid")):
            found.append(record)
    # Oldest session first, so a new mark is added on the right. A status
    # change does not change this order.
    found.sort(key=lambda item: (slot_stamp(item), str(item.get("id") or "")))
    return found


def hypr_text(args):
    ensure_hypr_env()
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    return result.stdout or ""


def parse_cursor_pos(text):
    raw = "".join((text or "").split())
    if "," not in raw:
        return None
    x_text, y_text = raw.split(",", 1)
    if not re.fullmatch(r"-?\d+", x_text) or not re.fullmatch(r"-?\d+", y_text):
        return None
    return int(x_text), int(y_text)


def _option_value(text, kind):
    for line in (text or "").splitlines():
        parts = line.split(":", 1)
        if len(parts) != 2 or parts[0].strip() != kind:
            continue
        rest = parts[1].strip()
        if not rest:
            return ""
        return rest.split()[0]
    return ""


def parse_hypr_bool(text):
    value = _option_value(text, "bool") or _option_value(text, "int")
    return "true" if value in ("true", "1") else "false"


def parse_hypr_choice(text, allowed=("0", "1", "2")):
    value = _option_value(text, "int")
    if value in allowed:
        return value
    return allowed[0]


def focus_lua(address, cursor, no_warps, warp_workspace):
    """Focus one window without leaving the pointer on it.

    Hyprland centers the pointer when a focus also changes workspace.
    Warps stay off for that dispatch, then the pointer goes back to the
    click. The caller's cursor options are restored in the same eval.
    """
    if not ADDR_RE.fullmatch(address or ""):
        raise ValueError("bad address")
    if no_warps not in ("true", "false"):
        no_warps = "false"
    if str(warp_workspace) not in ("0", "1", "2"):
        warp_workspace = "0"
    steps = [
        "hl.config({ cursor = { no_warps = true, warp_on_change_workspace = 0 } })",
        f'pcall(function() hl.dispatch(hl.dsp.focus({{ window = "address:{address}" }})) end)',
    ]
    if cursor is not None:
        x_pos, y_pos = cursor
        steps.append(f"hl.dispatch(hl.dsp.cursor.move({{ x = {int(x_pos)}, y = {int(y_pos)} }}))")
    steps.append(
        "hl.config({ cursor = { no_warps = "
        + no_warps
        + ", warp_on_change_workspace = "
        + str(warp_workspace)
        + " } })"
    )
    return "; ".join(steps)


def cmd_focus(argv):
    address = argv[1] if len(argv) > 1 else ""
    if not ADDR_RE.fullmatch(address):
        print("dashbots focus needs a window address", file=sys.stderr)
        return 2
    cursor = parse_cursor_pos(hypr_text(["hyprctl", "cursorpos"]))
    no_warps = parse_hypr_bool(hypr_text(["hyprctl", "getoption", "cursor:no_warps"]))
    warp = parse_hypr_choice(hypr_text(["hyprctl", "getoption", "cursor:warp_on_change_workspace"]))
    expr = focus_lua(address, cursor, no_warps, warp)
    if not hypr_text(["hyprctl", "eval", expr]):
        return 1
    return 0


def adopt_icon_set(records):
    """Move live marks onto the current set. A mark already in the set stays put."""
    catalog = bodies()
    if not catalog:
        return records
    for record in records:
        if sanitize_body(record.get("body"), catalog):
            continue
        ensure_body(record)
        write_record(record)
        written = read_record(session_path(sanitize_id(record.get("id"))))
        if written:
            record.clear()
            record.update(written)
    return records


def cmd_list(_argv=None):
    records = adopt_icon_set(live_records())
    print(json.dumps(records, sort_keys=True, separators=(",", ":")))
    return 0


def cmd_clear(argv):
    if "--all" in argv:
        directory = sessions_dir()
        if os.path.isdir(directory):
            for name in os.listdir(directory):
                if name.endswith(".json"):
                    try:
                        os.remove(os.path.join(directory, name))
                    except OSError:
                        pass
        return 0
    target = ""
    if "--id" in argv:
        target = flag_value(argv, "--id") or ""
    elif len(argv) > 1 and not str(argv[1]).startswith("-"):
        target = argv[1]
    session_id = sanitize_id(target)
    if not session_id:
        print("dashbots clear needs a session id, or --all", file=sys.stderr)
        return 2
    delete_record(session_id)
    return 0


def cmd_gc(_argv=None):
    directory = sessions_dir()
    if not os.path.isdir(directory):
        return 0
    records = list(iter_records())
    stale_ids = set(stale_same_pid_ids(records))
    hooked = set()
    for record in records:
        if record.get("source") != "hook":
            continue
        harness = sanitize_harness(record.get("harness"))
        try:
            hooked.add((harness, int(record.get("pid"))))
        except (TypeError, ValueError):
            continue
    for record in records:
        session_id = sanitize_id(record.get("id"))
        if not session_id:
            continue
        drop = not pid_alive(record.get("pid")) or session_id in stale_ids
        if record.get("source") == "scan" and has_marker(record.get("harness")):
            harness = sanitize_harness(record.get("harness"))
            try:
                pid = int(record.get("pid"))
            except (TypeError, ValueError):
                pid = None
            # Antigravity has no session-start hook. A scan mark is the idle
            # presence until a hook record for that pid exists.
            if harness != "agy" or (harness, pid) in hooked:
                drop = True
        if drop:
            delete_record(session_id)
    return 0


def has_marker(harness):
    harness = sanitize_harness(harness)
    if not harness:
        return False
    return os.path.isfile(os.path.join(adapters_dir(), harness))


def _refresh_presence(record, cwd, window):
    """Update the window and directory. Leave status and activity alone.

    A failed window lookup keeps the address a hook already wrote.
    """
    title = title_of(cwd, record.get("harness"))
    cwd = cwd or ""
    window = window or str(record.get("window") or "")
    if record.get("cwd") == cwd and record.get("title") == title and record.get("window") == window:
        return
    updated = dict(record)
    updated["cwd"] = cwd
    updated["title"] = title
    updated["window"] = window
    write_record(updated)


def ensure_agy_presence(window, pids):
    """A still mark for each agy process that no hook has claimed yet.

    window is a function from pid to a window address.
    """
    if not pids:
        return
    grouped = {}
    for record in iter_records():
        if sanitize_harness(record.get("harness")) != "agy":
            continue
        try:
            pid = int(record.get("pid"))
        except (TypeError, ValueError):
            continue
        grouped.setdefault(pid, []).append(record)
    for pid in pids:
        if not pid_alive(pid):
            continue
        found = grouped.get(pid, [])
        hooks = [record for record in found if record.get("source") == "hook"]
        scans = [record for record in found if record.get("source") == "scan"]
        cwd = cwd_of(pid)
        if hooks:
            for scan in scans:
                delete_record(scan.get("id"))
            _refresh_presence(hooks[0], cwd, window(pid))
            continue
        if scans:
            _refresh_presence(scans[0], cwd, window(pid))
            continue
        session_id = sanitize_id(f"scan-agy-{pid}")
        if not session_id:
            continue
        record = blank_record(session_id, "agy", pid, cwd)
        record["source"] = "scan"
        record["status"] = "alive"
        record["activity"] = ""
        record["window"] = window(pid)
        record["title"] = title_of(cwd, "agy")
        write_record(record)


# A pid keeps its harness for life, so the watcher classifies a pid once.
# Every RECHECK_SECONDS it reads every pid again. That catches a process that
# exec'd in place, or one read between fork and exec.
RECHECK_SECONDS = 30
# A pid with no window (tmux, a window still mapping) asks hyprctl at most this often.
WINDOW_RETRY_SECONDS = 10


class Scanner:
    """Discovery walk. One instance lives as long as the watcher."""

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.harnesses = {}
        self.windows = {}
        self.last_full = None
        self.clients = None

    def _found(self, now):
        full = self.last_full is None or now - self.last_full >= RECHECK_SECONDS
        if full:
            self.last_full = now
            self.windows = {}
        known = self.harnesses
        current = {}
        for pid in iter_pids():
            if not full and pid in known:
                current[pid] = known[pid]
            else:
                current[pid] = harness_of(pid)
        self.harnesses = current
        self.windows = {pid: seen for pid, seen in self.windows.items() if pid in current}
        return [(pid, harness) for pid, harness in current.items() if harness]

    def window(self, pid, now):
        cached = self.windows.get(pid)
        if cached and (cached[0] or now - cached[1] < WINDOW_RETRY_SECONDS):
            return cached[0]
        if self.clients is None:
            self.clients = hypr_clients()
        address = window_for(pid, self.clients)
        self.windows[pid] = (address, now)
        return address

    def scan(self):
        if not toggle_on():
            return 0
        now = self.clock()
        self.clients = None
        agy_pids = []
        try:
            for pid, harness in self._found(now):
                if not pid_alive(pid):
                    continue
                if harness == "agy":
                    agy_pids.append(pid)
                    continue
                if has_marker(harness):
                    continue
                cwd = cwd_of(pid)
                session_id = sanitize_id(f"scan-{harness}-{pid}")
                if not session_id:
                    continue
                record = blank_record(session_id, harness, pid, cwd)
                record["source"] = "scan"
                record["status"] = "alive"
                record["activity"] = ""
                record["window"] = self.window(pid, now)
                record["title"] = title_of(cwd, harness)
                previous = read_record(session_path(session_id))
                if previous and _scan_unchanged(previous, record):
                    continue
                write_record(record)
            ensure_agy_presence(lambda pid: self.window(pid, now), agy_pids)
        finally:
            self.clients = None
        return 0


def cmd_scan(_argv=None):
    return Scanner().scan()


def _scan_unchanged(previous, record):
    keys = ("harness", "pid", "cwd", "title", "status", "window", "activity", "source")
    return all(previous.get(key) == record.get(key) for key in keys)


def cmd_watch(_argv=None):
    scanner = Scanner()
    while True:
        if not toggle_on():
            return 0
        try:
            scanner.scan()
            cmd_gc()
        except Exception:
            if os.environ.get("DASHBOTS_DEBUG"):
                traceback.print_exc(file=sys.stderr)
        for _ in range(10):
            if not toggle_on():
                return 0
            time.sleep(0.2)


def flag_value(argv, name):
    if name not in argv:
        return None
    index = argv.index(name)
    if index + 1 >= len(argv):
        return None
    return argv[index + 1]


def cmd_report(argv):
    if not toggle_on():
        print("dashbots is off (toggle flag missing); report skipped", file=sys.stderr)
        return 0
    harness = sanitize_harness(flag_value(argv, "--harness") or "")
    if not harness:
        print("dashbots report needs --harness", file=sys.stderr)
        return 2
    session_id = sanitize_id(flag_value(argv, "--id") or "")
    if not session_id:
        print("dashbots report needs --id", file=sys.stderr)
        return 2
    raw_pid = flag_value(argv, "--pid")
    if raw_pid is None:
        pid = os.getppid()
    else:
        try:
            pid = int(raw_pid)
        except ValueError:
            print("dashbots report --pid must be an integer", file=sys.stderr)
            return 2
    status = flag_value(argv, "--status") or "alive"
    if status not in STATUSES:
        print("dashbots report --status must be alive, working, waiting, or error", file=sys.stderr)
        return 2
    cwd = flag_value(argv, "--cwd") or os.getcwd()
    source = flag_value(argv, "--source") or "hook"
    if source not in ("hook", "scan"):
        print("dashbots report --source must be hook or scan", file=sys.stderr)
        return 2
    record = blank_record(session_id, harness, pid, cwd)
    record["status"] = status
    record["source"] = source
    record["activity"] = first_line(flag_value(argv, "--activity") or "")
    title = flag_value(argv, "--title")
    if title:
        record["title"] = first_line(title)
    window = str(flag_value(argv, "--window") or "")
    record["window"] = window if ADDR_RE.fullmatch(window) else ""
    record["turn"] = str(flag_value(argv, "--turn") or "")
    if source == "hook":
        delete_scan_twin(pid)
    write_record(record)
    return 0


def read_hook_input(wait=2.0):
    """One JSON value from stdin. Do not wait for the pipe to close.

    A hook that reads until EOF sits there when the harness keeps stdin
    open, and a cancelled Antigravity turn then kills it. The mark stays
    "working" because Stop never lands. A complete value is enough.
    """
    try:
        fd = sys.stdin.fileno()
    except ValueError:
        return ""
    chunks = []
    decoder = json.JSONDecoder()
    deadline = time.monotonic() + wait
    while True:
        if chunks:
            text = b"".join(chunks).decode("utf-8", "replace").lstrip()
            try:
                _obj, end = decoder.raw_decode(text)
            except json.JSONDecodeError:
                pass
            else:
                return text[:end]
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return b"".join(chunks).decode("utf-8", "replace")
        try:
            ready, _, _ = select.select([fd], [], [], min(0.05, remaining))
        except (ValueError, OSError):
            return b"".join(chunks).decode("utf-8", "replace")
        if not ready:
            continue
        try:
            piece = os.read(fd, 65536)
        except OSError:
            return b"".join(chunks).decode("utf-8", "replace")
        if not piece:
            return b"".join(chunks).decode("utf-8", "replace")
        chunks.append(piece)


def cmd_hook(argv):
    try:
        harness = flag_value(argv, "--harness") or ""
        event = flag_value(argv, "--event") or ""
        raw = read_hook_input()
        if not raw.strip():
            return 0
        payload = json.loads(raw)
        if not isinstance(payload, dict):
            return 0
        # Antigravity stdin has no event name. The hook command carries it.
        if event and not event_name(payload):
            payload = dict(payload)
            payload["hook_event_name"] = event
        apply_hook(payload, harness)
    except Exception:
        if os.environ.get("DASHBOTS_DEBUG"):
            traceback.print_exc(file=sys.stderr)
    return 0


def hook_command(harness, timeout):
    command = os.path.join(lib_dir(), harness)
    entry = {"type": "command", "command": command, "timeout": timeout}
    return entry


def hook_group(harness, timeout, matcher=None):
    group = {"hooks": [hook_command(harness, timeout)]}
    if matcher:
        group = {"matcher": matcher, "hooks": [hook_command(harness, timeout)]}
    return group


def is_our_group(group, harness):
    if not isinstance(group, dict):
        return False
    for hook in group.get("hooks") or []:
        if not isinstance(hook, dict):
            continue
        command = str(hook.get("command") or "")
        if f"/lib/dashbots/{harness}" in command:
            return True
    return False


def merge_hooks(settings, harness, events, timeout, matchers=None):
    matchers = matchers or {}
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        hooks = {}
    for event in events:
        groups = hooks.get(event)
        if not isinstance(groups, list):
            groups = []
        groups = [group for group in groups if not is_our_group(group, harness)]
        groups.append(hook_group(harness, timeout, matchers.get(event)))
        hooks[event] = groups
    # Drop our groups for events this harness no longer installs. A stale
    # StopCancelled entry in Claude's settings is otherwise left in place
    # and warned on at every launch.
    wanted = set(events)
    for event, groups in list(hooks.items()):
        if event in wanted or not isinstance(groups, list):
            continue
        kept = [group for group in groups if not is_our_group(group, harness)]
        if kept:
            hooks[event] = kept
        else:
            hooks.pop(event, None)
    settings["hooks"] = hooks
    return settings


def load_json_object(path):
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    return data


def write_json(path, data):
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def install_wrapper(harness, gemini=False, agy=False):
    ensure_private_dir(os.path.dirname(lib_dir()))
    os.makedirs(lib_dir(), exist_ok=True)
    path = os.path.join(lib_dir(), harness)
    lines = [
        "#!/bin/sh",
        f'bin="$HOME/.local/bin/dashbots"',
    ]
    if agy:
        # PreToolUse stdout is a permission decision. {} denies on current
        # agy, and allow would authorize the tool. This hook answers ask,
        # which prompts and still honors Always Allow. The answer is printed
        # after the reporter, including when the reporter is off or fails.
        # Stop must not print "continue", or the turn would not end.
        # A cancelled turn kills this process. Stop is detached so the
        # mark can leave "working" after that kill. The pid is captured
        # first: the detached process is reparented and cannot walk back
        # to agy itself.
        lines.extend([
            "event=$1",
            "agy_pid() {",
            "  pid=$PPID",
            "  n=0",
            '  while [ "$n" -lt 40 ] && [ "$pid" -gt 1 ]; do',
            '    comm=$(cat "/proc/$pid/comm" 2>/dev/null) || return 1',
            '    if [ "$comm" = "agy" ]; then',
            "      printf '%s\\n' \"$pid\"",
            "      return 0",
            "    fi",
            "    pid=$(awk '/^PPid:/ { print $2 }' \"/proc/$pid/status\" 2>/dev/null) || return 1",
            "    n=$((n + 1))",
            "  done",
            "  return 1",
            "}",
            'if [ "$event" = "Stop" ]; then',
            '  pid=${DASHBOTS_HOOK_PID:-$(agy_pid 2>/dev/null)}',
            '  if [ -n "$pid" ] && command -v setsid >/dev/null 2>&1; then',
            '    DASHBOTS_HOOK_ASSUME=1 DASHBOTS_HOOK_PID=$pid \\',
            '      setsid -f "$bin" hook --harness agy --event "$event" >/dev/null 2>&1',
            "  else",
            '    "$bin" hook --harness agy --event "$event"',
            "  fi",
            "  printf '%s\\n' '{\"decision\":\"allow\"}'",
            "  exit 0",
            "fi",
            '"$bin" hook --harness agy --event "$event" || true',
            'if [ "$event" = "PreToolUse" ]; then',
            "  printf '%s\\n' '{\"decision\":\"ask\"}'",
            "else",
            "  printf '%s\\n' '{}'",
            "fi",
            "exit 0",
        ])
    elif gemini:
        lines.append(f'"$bin" hook --harness {harness}')
        lines.append("printf '%s\\n' '{}'")
        lines.append("exit 0")
    else:
        lines.append(f'exec "$bin" hook --harness {harness}')
    text = "\n".join(lines) + "\n"
    fd, tmp = tempfile.mkstemp(dir=lib_dir(), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(tmp, 0o755)
        os.replace(tmp, path)
        os.chmod(path, 0o755)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def install_bin_link():
    destination = bin_path()
    os.makedirs(os.path.dirname(destination), exist_ok=True)
    target = os.path.realpath(os.path.abspath(__file__))
    if os.path.islink(destination):
        current = os.path.realpath(destination)
        if current == target:
            return
        raise SystemExit(f"refusing to replace {destination} (points at {os.readlink(destination)})")
    if os.path.exists(destination):
        raise SystemExit(f"refusing to replace existing file {destination}")
    os.symlink(target, destination)


def write_markers():
    ensure_private_dir(adapters_dir())
    for harness in ADAPTERS:
        path = os.path.join(adapters_dir(), harness)
        fd = os.open(path, os.O_CREAT | os.O_WRONLY, 0o600)
        os.close(fd)
        os.chmod(path, 0o600)


def agy_hooks_path():
    override = os.environ.get("DASHBOTS_AGY_HOOKS_FILE")
    if override:
        return override
    return os.path.join(home(), ".gemini", "config", "hooks.json")


def agy_hook_command(event):
    command = os.path.join(lib_dir(), "agy") + " " + event
    return {"type": "command", "command": command, "timeout": 5}


def agy_hook_entry():
    entry = {}
    for event in ("PreToolUse", "PostToolUse"):
        entry[event] = [{"matcher": "*", "hooks": [agy_hook_command(event)]}]
    for event in ("PreInvocation", "PostInvocation", "Stop"):
        entry[event] = [agy_hook_command(event)]
    return entry


def agy_commands(entry):
    if not isinstance(entry, dict):
        return
    for groups in entry.values():
        if not isinstance(groups, list):
            continue
        for group in groups:
            if not isinstance(group, dict):
                continue
            if group.get("command"):
                yield str(group.get("command") or "")
            for hook in group.get("hooks") or []:
                if isinstance(hook, dict) and hook.get("command"):
                    yield str(hook.get("command") or "")


def agy_entry_is_ours(entry):
    commands = list(agy_commands(entry))
    return bool(commands) and all("/lib/dashbots/agy" in command for command in commands)


def merge_agy_hooks(settings):
    if not isinstance(settings, dict):
        settings = {}
    settings[AGY_HOOK_KEY] = agy_hook_entry()
    return settings


def install_agy_hooks():
    path = agy_hooks_path()
    loaded = load_json_object(path)
    if loaded is None:
        print(f"skipped agy: {path} is not strict JSON", file=sys.stderr)
        return False
    write_json(path, merge_agy_hooks(loaded))
    return True


def uninstall_agy_hooks():
    path = agy_hooks_path()
    if not os.path.exists(path):
        return
    loaded = load_json_object(path)
    if loaded is None:
        print(f"skipped agy: {path} is not strict JSON", file=sys.stderr)
        return
    entry = loaded.get(AGY_HOOK_KEY)
    if not agy_entry_is_ours(entry):
        return
    loaded.pop(AGY_HOOK_KEY, None)
    if loaded:
        write_json(path, loaded)
        return
    try:
        os.remove(path)
    except OSError:
        pass


def install_grok_hooks():
    path = os.path.join(home(), ".grok", "hooks", "dashbots.json")
    settings = merge_hooks(
        {},
        "grok",
        GROK_EVENTS,
        5,
        {"Notification": "idle_prompt|permission_prompt|elicitation_dialog"},
    )
    write_json(path, settings)


def install_settings_hooks(path, harness, events, timeout, matchers=None):
    loaded = load_json_object(path)
    if loaded is None:
        print(f"skipped {harness}: {path} is not strict JSON", file=sys.stderr)
        return False
    settings = merge_hooks(loaded, harness, events, timeout, matchers)
    write_json(path, settings)
    return True


def copy_file(src, dst, mode=0o644):
    if os.path.islink(dst):
        os.unlink(dst)
    parent = os.path.dirname(dst)
    if parent:
        os.makedirs(parent, exist_ok=True)
    shutil.copyfile(src, dst)
    os.chmod(dst, mode)


def svg_files(root):
    found = {}
    if not os.path.isdir(root):
        return found
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            name for name in dirnames if name != "_src" and not name.startswith(".")
        ]
        for filename in filenames:
            if not filename.endswith(".svg"):
                continue
            full = os.path.join(dirpath, filename)
            found[os.path.relpath(full, root)] = full
    return found


SHIPPED_MANIFEST = ".shipped"


def within_dir(root, rel):
    base = os.path.abspath(root)
    path = os.path.abspath(os.path.join(base, rel))
    if path == base or path.startswith(base + os.sep):
        return path
    return ""


def read_shipped_manifest(path):
    """Paths shipped last time. None means this destination has no record yet."""
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    found = []
    for line in lines:
        rel = line.strip()
        if not rel or rel.startswith("#") or rel.startswith("/") or "\\" in rel:
            continue
        parts = rel.split("/")
        if any(part in ("", ".", "..") for part in parts):
            continue
        found.append(rel)
    return found


def write_shipped_manifest(directory, rels):
    path = os.path.join(directory, SHIPPED_MANIFEST)
    body = "".join(rel + "\n" for rel in sorted(rels))
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".shipped-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def sync_icons(source, destination):
    """Copy shipped SVGs.

    The first sync drops leftovers from older installs. After that, a file
    the user added stays. A shipped file that left the source is removed.
    """
    os.makedirs(destination, exist_ok=True)
    wanted = svg_files(source)
    previous = read_shipped_manifest(os.path.join(destination, SHIPPED_MANIFEST))
    for rel, src in wanted.items():
        dest = within_dir(destination, rel)
        if not dest:
            continue
        parent = os.path.dirname(dest)
        if parent:
            os.makedirs(parent, exist_ok=True)
        copy_file(src, dest)
    if previous is None:
        stale = [rel for rel in svg_files(destination) if rel not in wanted]
    else:
        stale = [rel for rel in previous if rel not in wanted]
    for rel in stale:
        dest = within_dir(destination, rel)
        if not dest:
            continue
        try:
            os.remove(dest)
        except OSError:
            pass
    write_shipped_manifest(destination, wanted)
    for dirpath, _dirnames, _filenames in os.walk(destination, topdown=False):
        if os.path.abspath(dirpath) == os.path.abspath(destination):
            continue
        try:
            if not os.listdir(dirpath):
                os.rmdir(dirpath)
        except OSError:
            pass


CLONE_FILES = ("manifest.json", "README.md", "LICENSE", "preview.png", "config")
CLONE_DIRS = ("bin", "adapters", "systemd")
SKIP_COPY_DIRS = {".git", "tests", "__pycache__"}


def sync_tree(source, destination):
    """Mirror a support directory. Skip caches. A file that left the source is removed."""
    if not os.path.isdir(source):
        return
    os.makedirs(destination, exist_ok=True)
    wanted = set()
    for dirpath, dirnames, filenames in os.walk(source):
        dirnames[:] = [
            name for name in dirnames
            if name not in SKIP_COPY_DIRS and not name.startswith(".")
        ]
        rel_dir = os.path.relpath(dirpath, source)
        for filename in filenames:
            if filename.startswith("."):
                continue
            src = os.path.join(dirpath, filename)
            if not os.path.isfile(src):
                continue
            rel = filename if rel_dir == "." else os.path.join(rel_dir, filename)
            dest = within_dir(destination, rel)
            if not dest:
                continue
            mode = 0o755 if os.access(src, os.X_OK) else 0o644
            copy_file(src, dest, mode)
            wanted.add(rel)
    for dirpath, dirnames, filenames in os.walk(destination, topdown=False):
        for filename in filenames:
            full = os.path.join(dirpath, filename)
            rel = os.path.relpath(full, destination)
            if rel not in wanted:
                try:
                    os.remove(full)
                except OSError:
                    pass
        if os.path.abspath(dirpath) == os.path.abspath(destination):
            continue
        try:
            if not os.listdir(dirpath):
                os.rmdir(dirpath)
        except OSError:
            pass


def copy_plugin():
    """Sync a dev checkout into the plugin dir in clone shape.

    Running the binary from that directory skips the copy. Hooks, units,
    the menu, and the bar slot still run.
    """
    source_root = repo_root()
    destination = plugin_dir()
    if same_dir(source_root, destination):
        return
    os.makedirs(destination, exist_ok=True)
    for name in CLONE_FILES:
        src = os.path.join(source_root, name)
        if os.path.isfile(src):
            copy_file(src, os.path.join(destination, name))
    for name in CLONE_DIRS:
        sync_tree(os.path.join(source_root, name), os.path.join(destination, name))
    copy_file(
        os.path.join(source_root, "plugin", "BarWidget.qml"),
        os.path.join(destination, "plugin", "BarWidget.qml"),
    )
    sync_icons(
        os.path.join(source_root, "plugin", "icons"),
        os.path.join(destination, "plugin", "icons"),
    )


def keep_user_icons(legacy_icons, installed_icons):
    """Copy SVGs the user added in the old flat icons directory."""
    if not os.path.isdir(legacy_icons) or not os.path.isdir(installed_icons):
        return
    previous = read_shipped_manifest(os.path.join(legacy_icons, SHIPPED_MANIFEST))
    if previous is None:
        return
    shipped = set(previous)
    for rel, src in svg_files(legacy_icons).items():
        if rel in shipped:
            continue
        dest = within_dir(installed_icons, rel)
        if not dest or os.path.lexists(dest):
            continue
        parent = os.path.dirname(dest)
        if parent:
            os.makedirs(parent, exist_ok=True)
        copy_file(src, dest)


def remove_legacy_plugin_dir():
    legacy = legacy_plugin_dir()
    if same_dir(legacy, plugin_dir()):
        return
    if not os.path.isdir(legacy):
        return
    keep_user_icons(
        os.path.join(legacy, "icons"),
        os.path.join(plugin_dir(), "plugin", "icons"),
    )
    shutil.rmtree(legacy)


def legacy_icon_font_path():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(home(), ".local", "share")
    return os.path.join(base, "fonts", "dashbots", "Dashbots.ttf")


def remove_legacy_icon_font():
    dest = legacy_icon_font_path()
    parent = os.path.dirname(dest)
    try:
        os.remove(dest)
    except FileNotFoundError:
        return
    except OSError:
        return
    try:
        if parent and not os.listdir(parent):
            os.rmdir(parent)
    except OSError:
        pass
    try:
        subprocess.run(
            ["fc-cache", "-f", parent],
            capture_output=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def shell_up():
    try:
        result = subprocess.run(
            ["omarchy-shell", "shell", "ping"],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and "ok" in (result.stdout or "")


def plugin_known():
    try:
        result = subprocess.run(
            ["omarchy", "plugin", "list", "--json"],
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0:
        return False
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return False
    if not isinstance(data, list):
        return False
    return any(isinstance(item, dict) and item.get("id") == PLUGIN_ID for item in data)


def bar_has_id(plugin_id, config=None):
    if config is None:
        config = load_json_object(shell_json_path()) or {}
    layout = ((config.get("bar") or {}).get("layout") or {})
    for section in ("left", "center", "right"):
        for entry in layout.get(section) or []:
            if isinstance(entry, dict) and entry.get("id") == plugin_id:
                return True
    return False


def bar_has_dashbots(config=None):
    return bar_has_id(PLUGIN_ID, config)


def bar_layout(config):
    bar = config.setdefault("bar", {})
    layout = bar.setdefault("layout", {})
    for section in ("left", "center", "right"):
        entries = layout.get(section)
        if not isinstance(entries, list):
            layout[section] = []
    return layout


def anchor_index(entries, anchors):
    for anchor in anchors:
        for index, entry in enumerate(entries):
            if isinstance(entry, dict) and entry.get("id") == anchor:
                return index
    return None


def place_spec(place):
    if place not in PLACES:
        place = "center-right"
    return PLACES[place]


def chosen_anchor(entries, anchors):
    for name in anchors:
        if anchor_index(entries, (name,)) is not None:
            return name
    return None


def placed_correctly(layout, place):
    section, anchors, side = place_spec(place)
    found = []
    for name in ("left", "center", "right"):
        entries = layout.get(name) or []
        for index, entry in enumerate(entries):
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
                found.append((name, index))
    if len(found) != 1 or found[0][0] != section:
        return False
    entries = layout.get(section) or []
    index = found[0][1]
    anchor = anchor_index(entries, (chosen_anchor(entries, anchors),)) if chosen_anchor(entries, anchors) else None
    if anchor is None:
        if side == "after":
            return index == len(entries) - 1
        return index == 0
    if side == "after":
        return index == anchor + 1
    return index + 1 == anchor


def move_slot(layout, place):
    """Put the slot where `place` says. Return whether the layout changed."""
    section, anchors, side = place_spec(place)
    if placed_correctly(layout, place if place in PLACES else "center-right"):
        return False
    for name in ("left", "center", "right"):
        entries = layout.get(name) or []
        layout[name] = [
            entry for entry in entries
            if not (isinstance(entry, dict) and entry.get("id") == PLUGIN_ID)
        ]
    entries = layout[section]
    anchor_name = chosen_anchor(entries, anchors)
    anchor = anchor_index(entries, (anchor_name,)) if anchor_name else None
    slot = {"id": PLUGIN_ID}
    if anchor is None:
        if side == "after":
            entries.append(slot)
        else:
            entries.insert(0, slot)
    elif side == "after":
        entries.insert(anchor + 1, slot)
    else:
        entries.insert(anchor, slot)
    return True


def enable_command(layout, place):
    section, anchors, side = place_spec(place)
    entries = layout.get(section) or []
    chosen = chosen_anchor(entries, anchors)
    command = ["omarchy", "plugin", "enable", PLUGIN_ID, "--section", section]
    if chosen and side == "after":
        command.extend(["--after", chosen])
    elif chosen:
        command.extend(["--before", chosen])
    else:
        index = sum(
            1 for entry in entries
            if not (isinstance(entry, dict) and entry.get("id") == PLUGIN_ID)
        )
        if side == "before":
            index = 0
        command.extend(["--index", str(index)])
    return command


def write_placed(config, place):
    path = shell_json_path()
    layout = bar_layout(config)
    if not move_slot(layout, place):
        return 0
    if os.path.exists(path):
        stamp = datetime.now().strftime("%Y%m%d%H%M%S")
        shutil.copy(path, f"{path}.bak.{stamp}")
    write_json(path, config)
    return 0


def enable_placed(layout, place):
    try:
        subprocess.run(
            ["omarchy-shell", "shell", "rescanPlugins"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        debug(exc)
    result = subprocess.run(
        enable_command(layout, place),
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr or result.stdout or "enable failed\n")
        return result.returncode or 1
    text = (result.stdout or "").strip()
    if text:
        print(text)
    return 0


def apply_place():
    place = read_config()["place"]
    path = shell_json_path()
    config = load_json_object(path)
    if not isinstance(config, dict):
        print(f"{path} is not strict JSON; bar slot was not moved", file=sys.stderr)
        return 1
    layout = bar_layout(config)
    if placed_correctly(layout, place):
        return 0
    # A test shell file, or a shell that is not running, is edited directly.
    if os.environ.get("DASHBOTS_SHELL_FILE") or not shell_up():
        code = write_placed(config, place)
        if not os.environ.get("DASHBOTS_SHELL_FILE") and not shell_up():
            print("Shell is down. Moved the bar slot in shell.json.")
        return code
    if enable_placed(layout, place) == 0:
        return 0
    return write_placed(config, place)


def enable_bar_slot():
    code = apply_place()
    if code:
        raise SystemExit(code)


def cmd_place(_argv=None):
    return apply_place()


def install_units():
    destination = systemd_user_dir()
    os.makedirs(destination, exist_ok=True)
    source = os.path.join(repo_root(), "systemd")
    for name in ("dashbots.service", "dashbots.path"):
        shutil.copyfile(os.path.join(source, name), os.path.join(destination, name))
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False, timeout=20)
    subprocess.run(
        ["systemctl", "--user", "enable", "--now", "dashbots.path"],
        check=False,
        timeout=20,
    )
    # A watcher already running keeps the old code until it restarts.
    subprocess.run(
        ["systemctl", "--user", "try-restart", "dashbots.service"],
        check=False,
        timeout=20,
    )


def touch_flag():
    path = toggle_path()
    # Tests can point the flag at a temp file. Install on a real machine uses
    # the Omarchy toggle path, which is not the override.
    if os.environ.get("DASHBOTS_TOGGLE_FILE"):
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        open(path, "a", encoding="utf-8").close()
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "a", encoding="utf-8").close()


def menu_extension_path():
    override = os.environ.get("DASHBOTS_MENU_FILE")
    if override:
        return override
    return os.path.join(home(), ".config", "omarchy", "extensions", "omarchy-menu.jsonc")


def strip_jsonc(raw):
    # Same reductions the shell menu uses: full-line // comments, then trailing commas.
    text = re.sub(r"(?m)^\s*//[^\n]*(\n|$)", "", raw or "")
    return re.sub(r",(\s*[}\]])", r"\1", text)


def parse_menu_jsonc(raw):
    try:
        data = json.loads(strip_jsonc(raw))
    except json.JSONDecodeError:
        return None
    if not isinstance(data, dict):
        return None
    return data


def menu_entry_line():
    body = json.dumps(MENU_ENTRY, ensure_ascii=False)
    return f"  {json.dumps(MENU_ID)}: {body}"


def _menu_line_significant(line):
    text = line.strip()
    return bool(text) and not text.startswith("//")


def _brace_delta(line):
    depth = 0
    opened = False
    in_string = False
    escape = False
    for ch in line:
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            continue
        if ch == '"':
            in_string = True
        elif ch == "{":
            depth += 1
            opened = True
        elif ch == "}":
            depth -= 1
    return depth, opened


def _menu_entry_span(lines):
    prefix = json.dumps(MENU_ID)
    start = None
    for index, line in enumerate(lines):
        if line.lstrip().startswith(prefix):
            start = index
            break
    if start is None:
        return None
    depth = 0
    seen_open = False
    for index in range(start, len(lines)):
        delta, opened = _brace_delta(lines[index])
        depth += delta
        seen_open = seen_open or opened
        if seen_open and depth <= 0:
            return start, index + 1
    return start, len(lines)


def remove_menu_entry(text):
    lines = text.splitlines()
    span = _menu_entry_span(lines)
    if span is None:
        return text if text.endswith("\n") or not text else text + "\n"
    start, end = span
    del lines[start:end]
    nxt = start
    while nxt < len(lines) and not _menu_line_significant(lines[nxt]):
        nxt += 1
    if nxt < len(lines) and lines[nxt].strip() == "}":
        prev = start - 1
        while prev >= 0 and not _menu_line_significant(lines[prev]):
            prev -= 1
        if prev >= 0:
            stripped = lines[prev].rstrip()
            if stripped.endswith(","):
                lines[prev] = stripped[:-1].rstrip()
    return "\n".join(lines) + "\n"


def insert_menu_entry(text):
    line = menu_entry_line() + ","
    if not text.strip():
        return "{\n" + line + "\n}\n"
    lines = text.splitlines()
    close_at = None
    for index in range(len(lines) - 1, -1, -1):
        if lines[index].strip() == "}":
            close_at = index
            break
    if close_at is None:
        return "{\n" + line + "\n}\n"
    previous = close_at - 1
    while previous >= 0 and not _menu_line_significant(lines[previous]):
        previous -= 1
    if previous >= 0:
        stripped = lines[previous].rstrip()
        if stripped and not stripped.endswith(",") and not stripped.endswith("{"):
            lines[previous] = stripped + ","
    lines.insert(close_at, line)
    return "\n".join(lines) + "\n"


def _write_text(path, text):
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".tmp-menu-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def install_menu_trigger():
    path = menu_extension_path()
    original = ""
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as handle:
                original = handle.read()
        except OSError as exc:
            print(f"skipped menu trigger: {exc}", file=sys.stderr)
            return False
        parsed = parse_menu_jsonc(original)
        if parsed is None:
            print(f"skipped menu trigger: {path} is not JSONC", file=sys.stderr)
            return False
        if parsed.get(MENU_ID) == MENU_ENTRY:
            return True
        updated = insert_menu_entry(remove_menu_entry(original))
    else:
        updated = insert_menu_entry("")
    parsed = parse_menu_jsonc(updated)
    if not isinstance(parsed, dict) or parsed.get(MENU_ID) != MENU_ENTRY:
        print(f"skipped menu trigger: could not build a valid entry for {path}", file=sys.stderr)
        return False
    _write_text(path, updated)
    return True


def uninstall_menu_trigger():
    path = menu_extension_path()
    if not os.path.exists(path):
        return True
    try:
        with open(path, encoding="utf-8") as handle:
            original = handle.read()
    except OSError as exc:
        print(f"skipped menu trigger removal: {exc}", file=sys.stderr)
        return False
    if json.dumps(MENU_ID) not in original:
        return True
    updated = remove_menu_entry(original)
    parsed = parse_menu_jsonc(updated)
    if not isinstance(parsed, dict) or MENU_ID in parsed:
        print(f"skipped menu trigger removal: {path} would not stay valid JSONC", file=sys.stderr)
        return False
    if updated != original:
        _write_text(path, updated)
    return True


def cmd_install(_argv=None):
    install_bin_link()
    for harness in ADAPTERS:
        install_wrapper(harness, gemini=(harness == "gemini"), agy=(harness == "agy"))
    install_grok_hooks()
    install_agy_hooks()
    install_settings_hooks(
        os.path.join(home(), ".claude", "settings.json"),
        "claude",
        CLAUDE_EVENTS,
        5,
        {"Notification": "idle_prompt|permission_prompt|elicitation_dialog"},
    )
    install_settings_hooks(
        os.path.join(home(), ".gemini", "settings.json"),
        "gemini",
        GEMINI_EVENTS,
        5000,
    )
    copy_plugin()
    remove_legacy_icon_font()
    install_config()
    validate = subprocess.run(
        ["omarchy", "plugin", "validate", plugin_dir()],
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    if validate.returncode != 0:
        sys.stderr.write(validate.stderr or validate.stdout or "plugin validate failed\n")
        return validate.returncode or 1
    drop_legacy_bar_entry()
    remove_legacy_plugin_dir()
    write_markers()
    touch_flag()
    enable_bar_slot()
    install_units()
    menu_ok = install_menu_trigger()
    print("Installed dashbots.")
    print("Toggle with: omarchy toggle dashbots")
    if menu_ok:
        print("The same switch is in the Omarchy menu: Trigger, Toggle, Dashbots.")
    return 0


def strip_our_hooks(settings, harness):
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return settings
    empty = []
    for event, groups in list(hooks.items()):
        if not isinstance(groups, list):
            continue
        kept = [group for group in groups if not is_our_group(group, harness)]
        if kept:
            hooks[event] = kept
        else:
            empty.append(event)
    for event in empty:
        hooks.pop(event, None)
    if not hooks:
        settings.pop("hooks", None)
    return settings


def uninstall_settings(path, harness):
    if not os.path.exists(path):
        return
    loaded = load_json_object(path)
    if loaded is None:
        print(f"skipped {harness}: {path} is not strict JSON", file=sys.stderr)
        return
    strip_our_hooks(loaded, harness)
    if loaded:
        write_json(path, loaded)
    else:
        try:
            os.remove(path)
        except OSError:
            pass


def disable_plugin(plugin_id):
    try:
        subprocess.run(
            ["omarchy", "plugin", "disable", plugin_id],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def strip_bar_ids(plugin_ids):
    """Remove bar entries for these plugin ids. No-op when none of them are present."""
    wanted = set(plugin_ids)
    if not any(bar_has_id(plugin_id) for plugin_id in wanted):
        return
    path = shell_json_path()
    config = load_json_object(path)
    if not isinstance(config, dict):
        print(f"could not remove the bar slot; {path} is not strict JSON", file=sys.stderr)
        return
    layout = ((config.get("bar") or {}).get("layout") or {})
    changed = False
    for section in ("left", "center", "right"):
        entries = layout.get(section)
        if not isinstance(entries, list):
            continue
        kept = [
            entry for entry in entries
            if not (isinstance(entry, dict) and entry.get("id") in wanted)
        ]
        if len(kept) != len(entries):
            layout[section] = kept
            changed = True
    if not changed:
        return
    stamp = datetime.now().strftime("%Y%m%d%H%M%S")
    shutil.copy(path, f"{path}.bak.{stamp}")
    write_json(path, config)


def drop_legacy_bar_entry():
    disable_plugin(LEGACY_PLUGIN_ID)
    strip_bar_ids((LEGACY_PLUGIN_ID,))


def remove_bar_entry():
    disable_plugin(PLUGIN_ID)
    disable_plugin(LEGACY_PLUGIN_ID)
    strip_bar_ids((PLUGIN_ID, LEGACY_PLUGIN_ID))


def cmd_uninstall(_argv=None):
    flag = toggle_path()
    if not os.environ.get("DASHBOTS_TOGGLE_FILE"):
        try:
            os.remove(flag)
        except FileNotFoundError:
            pass
    subprocess.run(
        ["systemctl", "--user", "disable", "--now", "dashbots.path"],
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    subprocess.run(
        ["systemctl", "--user", "stop", "dashbots.service"],
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    for name in ("dashbots.service", "dashbots.path"):
        try:
            os.remove(os.path.join(systemd_user_dir(), name))
        except FileNotFoundError:
            pass
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True, timeout=20, check=False)
    remove_bar_entry()
    try:
        subprocess.run(
            ["omarchy-shell", "shell", "rescanPlugins"],
            capture_output=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    grok_hook = os.path.join(home(), ".grok", "hooks", "dashbots.json")
    try:
        os.remove(grok_hook)
    except FileNotFoundError:
        pass
    uninstall_settings(os.path.join(home(), ".claude", "settings.json"), "claude")
    uninstall_settings(os.path.join(home(), ".gemini", "settings.json"), "gemini")
    uninstall_agy_hooks()
    if os.path.isdir(lib_dir()):
        shutil.rmtree(lib_dir())
    for harness in ADAPTERS:
        try:
            os.remove(os.path.join(adapters_dir(), harness))
        except FileNotFoundError:
            pass
    destination = bin_path()
    if os.path.islink(destination):
        target = os.path.realpath(destination)
        if os.path.basename(target) == "dashbots" and target.endswith(os.path.join("bin", "dashbots")):
            os.remove(destination)
    uninstall_menu_trigger()
    remove_legacy_icon_font()
    print("Uninstalled dashbots. Session records were left in the state directory.")
    return 0


def cmd_status(_argv=None):
    print(f"toggle: {'on' if toggle_on() else 'off'}")
    print(f"flag: {toggle_path()}")
    link = bin_path()
    if os.path.islink(link):
        print(f"bin: {link} -> {os.readlink(link)}")
    elif os.path.exists(link):
        print(f"bin: {link} (not a symlink)")
    else:
        print("bin: missing")
    for harness in ADAPTERS:
        marker = "marker" if has_marker(harness) else "no marker"
        wrapper = os.path.join(lib_dir(), harness)
        present = "wrapper" if os.path.isfile(wrapper) else "no wrapper"
        print(f"adapter {harness}: {present}, {marker}")
    try:
        active = subprocess.run(
            ["systemctl", "--user", "is-active", "dashbots.service"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        enabled = subprocess.run(
            ["systemctl", "--user", "is-enabled", "dashbots.path"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        print(f"watcher: {(active.stdout or '').strip() or 'unknown'}")
        print(f"path unit: {(enabled.stdout or '').strip() or 'unknown'}")
    except (OSError, subprocess.TimeoutExpired):
        print("watcher: unknown")
    menu_text = ""
    try:
        with open(menu_extension_path(), encoding="utf-8") as handle:
            menu_text = handle.read()
    except OSError:
        menu_text = ""
    menu = parse_menu_jsonc(menu_text) if menu_text else None
    row = isinstance(menu, dict) and menu.get(MENU_ID) == MENU_ENTRY
    print(f"menu: {'Trigger, Toggle, Dashbots' if row else 'absent'}")
    print(f"live: {len(live_records())}")
    settings = read_config()
    print(f"config: {config_path()}")
    print(f"swingMs: {settings['swingMs']}")
    print(f"animate: {'true' if settings['animate'] else 'false'}")
    print(f"place: {settings['place']}")
    print(f"icons: {settings['icons']}")
    return 0


def cmd_rebody(_argv=None):
    """Move live marks onto the icon set named in the config."""
    adopt_icon_set(live_records())
    return 0


def usage():
    print(
        "Usage: dashbots <report|clear|hook|watch|gc|scan|list|focus|place|rebody|install|uninstall|status>",
        file=sys.stderr,
    )


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        usage()
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    command = argv[0]
    if command == "hook":
        return cmd_hook(argv)
    dispatch = {
        "report": cmd_report,
        "clear": cmd_clear,
        "watch": cmd_watch,
        "gc": cmd_gc,
        "scan": cmd_scan,
        "list": cmd_list,
        "focus": cmd_focus,
        "place": cmd_place,
        "rebody": cmd_rebody,
        "install": cmd_install,
        "uninstall": cmd_uninstall,
        "status": cmd_status,
    }
    func = dispatch.get(command)
    if not func:
        usage()
        return 2
    return func(argv)


if __name__ == "__main__":
    sys.exit(main())
